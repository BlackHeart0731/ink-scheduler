# このファイルを .env という名前でコピーして使う（.env は Git に入らない）
#   cp .env.example .env

# 管理画面を開くときのパスワード（空ならパスワードなし）
# 英数字だけにしてください（$ や # などの記号は docker compose が解釈してしまいます）
INK_SCHEDULER_PASSWORD=

# 管理画面の公開先
#   127.0.0.1 : そのPCの中だけ
#   0.0.0.0   : 同じネットワークの他のPCからも開ける（必ずパスワードを設定してください）
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8501

# data/ の持ち主。id -u と id -g の結果に合わせる
APP_UID=1000
APP_GID=1000

# ログの時刻（予約の時刻は管理画面の「設定」のタイムゾーンで決まります）
TZ=Asia/Tokyo
